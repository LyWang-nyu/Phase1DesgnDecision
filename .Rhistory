# predictor matrix is a modified lower diagonal
predictor_matrix <- matrix(0, ncol(pathw1to5a_micedat), ncol(pathw1to5a_micedat))
predictor_matrix[lower.tri(predictor_matrix, diag = F)] <- 1
# customization: v is imputed by all v other than itself,
predictor_matrix[c(1:n.v), c(1:n.v)] <- diag(n.v)
predictor_matrix[c(1:n.v), c(1:n.v)] <- abs(1 - predictor_matrix[c(1:n.v), c(1:n.v)])
