library(gFormulaMI)
library(data.table)
library(patchwork)
library(mice)
simulate_q1 <- function(n = 50, nsim = 5000, a = 2, b = 8) {
# storage
a_mom <- numeric(nsim)
b_mom <- numeric(nsim)
a_mle <- numeric(nsim)
b_mle <- numeric(nsim)
for (s in 1:nsim) {
x <- runif(n, min = a, max = b)
xbar <- mean(x)
m2 <- mean(x^2)
# MOM estimators
delta <- sqrt(3 * (m2 - xbar^2))
a_mom[s] <- xbar - delta
b_mom[s] <- xbar + delta
# MLE estimators
a_mle[s] <- min(x)
b_mle[s] <- max(x)
}
results <- data.frame(
Estimator = c("a_MOM", "a_MLE", "b_MOM", "b_MLE"),
Mean = c(mean(a_mom), mean(a_mle), mean(b_mom), mean(b_mle)),
Variance = c(var(a_mom), var(a_mle), var(b_mom), var(b_mle)),
Bias = c(mean(a_mom) - a, mean(a_mle) - a, mean(b_mom) - b, mean(b_mle) - b)
)
list(
summary = results,
draws = data.frame(a_mom = a_mom, a_mle = a_mle,
b_mom = b_mom, b_mle = b_mle)
)
}
# run Question 1 simulation
q1_out <- simulate_q1(n = 50, nsim = 5000, a = 2, b = 8)
q1_out$summary
par(mfrow = c(2, 2))
hist(q1_out$draws$a_mom, main = "Q1: a_MOM", xlab = "estimate")
abline(v = 2, lwd = 2, lty = 2)
hist(q1_out$draws$a_mle, main = "Q1: a_MLE", xlab = "estimate")
abline(v = 2, lwd = 2, lty = 2)
hist(q1_out$draws$b_mom, main = "Q1: b_MOM", xlab = "estimate")
abline(v = 8, lwd = 2, lty = 2)
hist(q1_out$draws$b_mle, main = "Q1: b_MLE", xlab = "estimate")
abline(v = 8, lwd = 2, lty = 2)
par(mfrow = c(2, 2))
hist(q1_out$draws$a_mom, main = "Q1: a_MOM", xlab = "estimate", breaks = 30)
abline(v = 2, lwd = 2, lty = 2)
par(mfrow = c(2, 2))
hist(q1_out$draws$a_mom, main = "Q1: a_MOM", xlab = "estimate", breaks = 30)
abline(v = 2, lwd = 2, lty = 2)
hist(q1_out$draws$a_mle, main = "Q1: a_MLE", xlab = "estimate", breaks = 30)
abline(v = 2, lwd = 2, lty = 2)
hist(q1_out$draws$b_mom, main = "Q1: b_MOM", xlab = "estimate", breaks=30)
abline(v = 8, lwd = 2, lty = 2)
hist(q1_out$draws$b_mle, main = "Q1: b_MLE", xlab = "estimate", breaks = 30)
abline(v = 8, lwd = 2, lty = 2)
simulate_q2 <- function(n = 50, nsim = 5000, theta = 2) {
# To simulate from this distribution:
# F(x) = x^theta, so X = U^(1/theta), U~Unif(0,1)
theta_mom <- numeric(nsim)
theta_mle <- numeric(nsim)
for (s in 1:nsim) {
u <- runif(n)
x <- u^(1 / theta)
xbar <- mean(x)
# MOM estimator
theta_mom[s] <- xbar / (1 - xbar)
# MLE estimator
theta_mle[s] <- -n / sum(log(x))
}
results <- data.frame(
Estimator = c("theta_MOM", "theta_MLE"),
Mean = c(mean(theta_mom), mean(theta_mle)),
Variance = c(var(theta_mom), var(theta_mle)),
Bias = c(mean(theta_mom) - theta, mean(theta_mle) - theta)
)
list(
summary = results,
draws = data.frame(theta_mom = theta_mom, theta_mle = theta_mle)
)
}
# run Question 2 simulation
q2_out <- simulate_q2(n = 50, nsim = 5000, theta = 2)
q2_out$summary
par(mfrow = c(1, 2))
hist(q2_out$draws$theta_mom, main = "Q2: theta_MOM", xlab = "estimate", breaks = 30)
abline(v = 2, lwd = 2, lty = 2)
hist(q2_out$draws$theta_mle, main = "Q2: theta_MLE", xlab = "estimate", breaks = 30)
abline(v = 2, lwd = 2, lty = 2)
